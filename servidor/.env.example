# ─────────────────────────────────────────────────────────────────────────────
# Variables del SERVIDOR (la API).
#   · En tu PC: copiá este archivo como servidor/.env y completalo.
#   · En Render: cargá las marcadas [RENDER] en Environment (no se sube ningún .env).
# Nunca subas el .env real a GitHub (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Solo en tu PC (Postgres instalado localmente), si no usás BD_URL_NEON:
BD_HOST=localhost
BD_PUERTO=5432
BD_NOMBRE=mi_base
BD_USUARIO=postgres
BD_CONTRASENA=tu_contrasena
# Puerto de la API en tu PC. En Render NO se carga: Render lo pone solo.
PORT=3001


# [RENDER] Siempre "production" en Render. En tu PC: development.
NODE_ENV=development

# ── Base de datos ────────────────────────────────────────────────────────────
# [RENDER] Dirección de conexión que te da Neon (Dashboard → Connect → "Connection string").
#          Empieza con postgresql:// . Si está cargada, se ignoran las BD_ de tu PC de abajo.
BD_URL_NEON=
# Conexión cifrada. Con Neon se activa sola; en tu PC: false.
BD_SSL=false

# [RENDER] Esquema (carpeta de tablas) de este cliente dentro de la base. Uno por cliente.
BD_ESQUEMA=mi_eccomerce
# Esquema que usan los tests (se borra en cada corrida: tiene que terminar en _test).
BD_ESQUEMA_TEST=mi_eccomerce_test
# [RENDER] true: al arrancar crea/actualiza las tablas y el primer admin. Dejalo en true.
MIGRAR_AL_INICIAR=true

# ── Sesiones y seguridad ────────────────────────────────────────────────────
# [RENDER] Texto largo al azar que firma los inicios de sesión. Uno distinto por cliente y por entorno.
#          Generalo con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#          Si se cambia, todos los usuarios tienen que volver a ingresar.
CLAVE_SESIONES=cambiar_por_un_texto_largo_y_aleatorio_de_32_o_mas
# Cuánto dura una sesión (7d = 7 días, 12h = 12 horas).
DURACION_SESION=7d
# Intentos de login por persona cada 15 minutos (protección contra fuerza bruta).
INTENTOS_LOGIN=10
# [RENDER] Dirección de la tienda en Vercel (ej. https://mi-tienda.vercel.app). Solo desde ahí
#          se puede usar la API. Si tenés dominio propio, agregalo separado por coma.
#          En tu PC dejalo vacío (se permite Vite en localhost).
URL_FRONTEND_VERCEL=

# ── Imágenes (Cloudinary → Dashboard → API Keys). Opcionales ────────────────
# [RENDER] Sin estas, las imágenes solo se pueden cargar pegando una dirección https.
CLOUDINARY_NOMBRE_NUBE=
CLOUDINARY_CLAVE_API=
CLOUDINARY_SECRETO_API=
# [RENDER] Carpeta de este cliente en Cloudinary (así no se mezclan las fotos de distintos clientes).
CLOUDINARY_CARPETA=mi_eccomerce

# ── Primer usuario (super admin) ──────────────────────────── ────────────────
# [RENDER] Se crea al arrancar si no existe. Después, la contraseña se cambia desde el sistema
#          (cambiarla acá no modifica un usuario ya creado).
SUPERADMIN_NOMBRE=Admin
SUPERADMIN_EMAIL=admin@ejemplo.com
SUPERADMIN_CONTRASENA=cambiar_esta_contrasena
