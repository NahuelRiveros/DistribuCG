# Copiá este archivo como ".env" y completá los valores reales. Nunca subir .env a git.

NODE_ENV=development
PORT=3001

# ── Base de datos local (mismos nombres de variables que DistribuCG) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_de_tu_base
DB_USER=postgres
DB_PASS=tu_contrasena
DB_SSL=false

# Cada proyecto vive en su propio schema dentro de la base.
# Los tests BORRAN y recrean DB_SCHEMA_TEST en cada corrida: tiene que terminar en "_test".
DB_SCHEMA=mi_eccomerce
DB_SCHEMA_TEST=mi_eccomerce_test

# Al arrancar, aplicar migraciones pendientes y datos base (roles, super admin)
MIGRAR_AL_INICIAR=true

# ── Producción (Neon): si está seteada, tiene prioridad sobre DB_HOST/DB_NAME ──
# NEON_DATABASE_URL=postgres://usuario:clave@host.neon.tech/base?sslmode=require

# ── Seguridad ──
# Mínimo 32 caracteres aleatorios.
JWT_SECRET=cambiar_por_un_texto_largo_y_aleatorio_de_32_o_mas
JWT_EXPIRA=7d
# Intentos de login por IP + email cada 15 minutos
LIMITE_LOGIN=10
# Orígenes permitidos separados por coma. Vacío = solo localhost en desarrollo.
CORS_ORIGIN=

# ── Imágenes (Cloudinary). Opcional: sin esto se cargan imágenes pegando su URL ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CARPETA=mi_eccomerce

# ── Super admin inicial (lo crea `npm run db:seed` si no existe) ──
SUPERADMIN_NOMBRE=Admin
SUPERADMIN_EMAIL=admin@ejemplo.com
SUPERADMIN_PASSWORD=cambiar_esta_contrasena
