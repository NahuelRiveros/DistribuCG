# ─────────────────────────────────────────────────────────────────
#  PLANTILLA DE VARIABLES DE ENTORNO — Dynamic Gym API
#  Copiá este archivo como ".env" y completá los valores reales.
#  NUNCA subas ".env" a git. Solo ".env.example" va al repositorio.
#
#  ARQUITECTURA EN PRODUCCIÓN:
#    Frontend: https://dynamic-gym.vercel.app        (Vercel)
#    Backend:  https://dynamic-gym.onrender.com      (Render)
# ─────────────────────────────────────────────────────────────────

NODE_ENV=development        # "development" | "production"
PORT=3001                   # Render asigna el suyo automáticamente

# ── Base de datos ─────────────────────────────────────────────────
# PRODUCCIÓN (Render): Render completa DATABASE_URL automáticamente
DATABASE_URL=

# LOCAL: usá las variables individuales
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dynamicgym
DB_USER=postgres
DB_PASS=TU_PASSWORD_AQUI

# SSL: false en local, true en Render/producción
DB_SSL=false

# ── Seguridad ─────────────────────────────────────────────────────
# OBLIGATORIO en producción.
# Generá uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# En Render: usá el botón "Generate" en Environment Variables.
JWT_SECRET=CAMBIA_ESTE_VALOR_POR_UNO_LARGO_Y_ALEATORIO

# ── CORS ──────────────────────────────────────────────────────────
# LOCAL: vacío (permite todo)
# PRODUCCIÓN en Render: poner el dominio exacto de Vercel
# Múltiples dominios separados por coma
CORS_ORIGIN=
# Ejemplo producción: CORS_ORIGIN=https://dynamic-gym.vercel.app

# ── Cloudinary (imágenes/videos del home) ─────────────────────────
# Obtenelo en https://console.cloudinary.com/console → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Seed: usuario super admin ──────────────────────────────────────
# Se crea (una sola vez) al arrancar el server si no existe todavía.
SUPERADMIN_NOMBRE=
SUPERADMIN_APELLIDO=
SUPERADMIN_DNI=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
