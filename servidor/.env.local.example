# ─────────────────────────────────────────────────────────────────
#  LOCAL — tu PC, con PostgreSQL local
#
#  Copiá este archivo como ".env.local" (queda fuera de git) y completá lo tuyo.
#  Es el ÚNICO archivo que lee el servidor en tu PC: BD_URL queda vacía a propósito,
#  así tu PC nunca se conecta a la base de producción.
#  Revisá los nombres con: npm --prefix servidor run env:verificar
# ─────────────────────────────────────────────────────────────────

# ── Servidor ──
NODE_ENV=development
PORT=3001
# En tu PC sirve cualquier texto; en producción va uno largo y al azar.
JWT_SECRET=CLAVE_SOLO_PARA_MI_PC
SEED_SECRET=
# Vacío: permite los orígenes locales conocidos (localhost:5173…).
CORS_ORIGIN=

# ── Super admin de prueba (se crea en tu base local) ──
SUPERADMIN_NOMBRE=Admin
SUPERADMIN_APELLIDO=Local
SUPERADMIN_DNI=11111111
SUPERADMIN_EMAIL=admin@local.test
SUPERADMIN_PASSWORD=[COMPLETAR]

# ── Base de datos: PostgreSQL local ──
# Vacía SIEMPRE en este archivo: con BD_URL el servidor usaría esa dirección.
BD_URL=
DB_SCHEMA=gc_dist_test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coreSistem
DB_USER=postgres
DB_PASS=25466178
DB_SSL=false

# ── Tienda local (Vite) ──
VERCEL_FRONTEND_URL=http://localhost:5173

# ── Correo en tu PC (opcional; vacío = no se envía nada) ──
# Con Gmail: "contraseña de aplicación" de https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Imágenes (opcional en tu PC: sin esto no se pueden subir fotos) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Ingreso con Google (el mismo Client ID, público) ──
GOOGLE_CLIENT_ID=274262080049-uagtdmi43f9d9q2pn5ij1dh8o5b9q00c.apps.googleusercontent.com

# ── Arranque ──
# true = completa el catálogo de ejemplo con precios inventados (solo en tu PC).
CATALOGO_DEMO_AL_INICIAR=false
IMAGENES_CATALOGO_AL_INICIAR=false
