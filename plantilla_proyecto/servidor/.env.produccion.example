# ─────────────────────────────────────────────────────────────────
#  PRODUCCIÓN — API de [COMPLETAR nombre] en Render
#
#  1. Copiá este archivo como ".env.produccion" (queda fuera de git) y reemplazá cada
#     [COMPLETAR] por el valor real. Los valores reales van SOLO en .env.produccion:
#     este molde va a git y lo ve cualquiera con acceso al repositorio.
#  2. En Render: Service → Environment → "Add from .env" → pegá el contenido entero.
#
#  El código NUNCA lee este archivo en tu PC (allí se usa .env.local). Solo lo leen, a
#  propósito, los scripts que tocan producción: catalogo:retirar-demo, admin:verificar
#  e imagenes:subir.
#  Comentarios siempre en su propia línea: Render tomaría un "# ..." al final como parte
#  del valor. Revisá los nombres con: npm --prefix servidor run env:verificar
#
#  ══ ANTES DE PASAR A PRODUCCIÓN REAL ══
#  Si alguno de estos valores se compartió alguna vez (chat, mail, captura), dejó de ser
#  secreto: generá uno nuevo.
#    🔑 JWT_SECRET            → uno nuevo, largo y al azar (cierra las sesiones abiertas).
#    🔑 SUPERADMIN_PASSWORD   → cambiala desde la app y poné la nueva acá (solo sirve al crear el admin).
#    🔑 BD_URL                → Supabase → Project Settings → Database → "Reset database password",
#                               y actualizá la contraseña dentro de la dirección.
#    🔑 CLOUDINARY_API_SECRET → Cloudinary → Settings → API Keys → generar un par nuevo (cambia
#                               también CLOUDINARY_API_KEY) y borrar el viejo.
#    ⚙️ DB_SCHEMA=mi_proyecto, CATALOGO_DEMO_AL_INICIAR=false y SUPERADMIN_EMAIL / _DNI reales.
# ─────────────────────────────────────────────────────────────────

# ── Servidor ──
NODE_ENV=production
# URL de esta API (MercadoPago le manda acá el aviso de pago).
RENDER_APP_URL=https://[COMPLETAR].onrender.com
# Largo y al azar. En Render podés usar el botón "Generate".
JWT_SECRET=[COMPLETAR]
# Clave para las rutas de soporte (header x-seed-token). Vacía = esas rutas apagadas.
SEED_SECRET=
# Dominio exacto de la tienda en Vercel (varios, separados por coma).
CORS_ORIGIN=https://[COMPLETAR].vercel.app

# ── Super admin (se crea una sola vez; no pisa una contraseña existente) ──
SUPERADMIN_NOMBRE=[COMPLETAR]
SUPERADMIN_APELLIDO=[COMPLETAR]
SUPERADMIN_DNI=[COMPLETAR]
SUPERADMIN_EMAIL=[COMPLETAR]
SUPERADMIN_PASSWORD=[COMPLETAR]

# ── Base de datos (Supabase) ──
# Supabase → Connect → "Session pooler" (puerto 5432). Dirección completa, sin corchetes.
BD_URL=postgresql://postgres.[COMPLETAR]:[COMPLETAR]@[COMPLETAR].pooler.supabase.com:5432/postgres
# Schema de producción. Escribilo bien: un nombre distinto crea un schema nuevo y vacío.
DB_SCHEMA=mi_proyecto
DB_SSL=true

# ── Tienda (Vercel) ──
VERCEL_FRONTEND_URL=https://[COMPLETAR].vercel.app

# ── Suscripción del software (MercadoPago) ──
# Token PROD de https://www.mercadopago.com.ar/developers/panel/app. Vacío = no se puede cobrar.
MP_ACCESS_TOKEN=
# Precio mensual en pesos, sin centavos (ej. 10000).
SOFTWARE_PRECIO=
SOFTWARE_CLIENTE=

# ── Correo (Brevo: Render gratis bloquea el SMTP) ──
CLAVE_API_BREVO=
# Correo verificado en Brevo.
CORREO_REMITENTE=
NOMBRE_REMITENTE=

# ── Imágenes (Cloudinary). Obligatorio: sin esto el servidor no arranca. ──
CLOUDINARY_CLOUD_NAME=[COMPLETAR]
CLOUDINARY_API_KEY=[COMPLETAR]
CLOUDINARY_API_SECRET=[COMPLETAR]

# ── Ingreso con Google (público; el mismo que VITE_GOOGLE_CLIENT_ID de Vercel) ──
GOOGLE_CLIENT_ID=274262080049-uagtdmi43f9d9q2pn5ij1dh8o5b9q00c.apps.googleusercontent.com

# ── Facturación ARCA (preparada, sin uso: vacías = apagada) ──
ARCA_CUIT_EMISOR=
ARCA_PUNTO_VENTA=
ARCA_CERTIFICADO_PEM=
ARCA_CLAVE_PRIVADA_PEM=
ARCA_PRODUCCION=false

# ── Arranque ──
# Nunca true en producción: precios inventados (igual se saltea en mi_proyecto).
CATALOGO_DEMO_AL_INICIAR=false
# true = pone las fotos de Cloudinary a los artículos sin foto, por código.
IMAGENES_CATALOGO_AL_INICIAR=false
